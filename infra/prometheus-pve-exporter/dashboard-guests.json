          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "(rate(pve_network_receive_bytes_total[$${__rate_interval}]) + rate(pve_network_transmit_bytes_total[$${__rate_interval}])) * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
