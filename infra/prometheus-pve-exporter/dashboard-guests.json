        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pve_memory_usage_bytes * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 6
    },
    {
      "type": "table",
      "title": "Guests",
      "datasource": "$${DS_PROMETHEUS}",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "pve_up * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "pve_cpu_usage_limit * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"}",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "pve_cpu_usage_ratio * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"}",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "pve_memory_size_bytes * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"}",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "pve_memory_usage_bytes * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"}",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "pve_disk_size_bytes * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"}",
          "legendFormat": "",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "expr": "pve_uptime_seconds * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"}",
          "legendFormat": "",
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "id": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "pod": true,
              "namespace": true,
              "container": true,
              "endpoint": true,
              "tags": true,
              "template": true,
              "type": true
            },
            "indexByName": {
              "name": 0,
              "node": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8
            },
            "renameByName": {
              "name": "VM",
              "node": "Node",
              "Value #A": "Status",
              "Value #B": "vCPU",
              "Value #C": "CPU",
              "Value #D": "RAM",
              "Value #E": "RAM used",
              "Value #F": "Disk",
              "Value #G": "Uptime"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "VM"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "stopped",
                        "color": "red",
                        "index": 0
                      },
                      "1": {
                        "text": "running",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.7
                    },
                    {
                      "color": "red",
                      "value": 0.9
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM used"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Disk"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Uptime"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "CPU per VM",
      "datasource": "$${DS_PROMETHEUS}",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "pve_cpu_usage_ratio * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
