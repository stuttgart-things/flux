{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": [
    "proxmox",
    "pve",
    "infrastructure"
  ],
  "title": "Proxmox VE - tagged guests",
  "uid": "proxmox-pve-tagged-guests",
  "description": "Guests carrying one PVE tag (default stuttgart-things); templates excluded.",
  "links": [
    {
      "title": "Proxmox VE",
      "type": "link",
      "url": "/d/proxmox-pve-exporter/proxmox-ve"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource"
      },
      {
        "name": "tag",
        "type": "textbox",
        "label": "PVE tag",
        "query": "stuttgart-things",
        "current": {
          "text": "stuttgart-things",
          "value": "stuttgart-things"
        },
        "hide": 0
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "panels": [
    {
      "type": "stat",
      "title": "VMs running",
      "datasource": "$${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count((pve_up * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"}) == 1) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 1
    },
    {
      "type": "stat",
      "title": "VMs stopped",
      "datasource": "$${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count((pve_up * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"}) == 0) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 2
    },
    {
      "type": "stat",
      "title": "vCPUs allocated",
      "datasource": "$${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pve_cpu_usage_limit * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 3
    },
    {
      "type": "stat",
      "title": "CPU in use (cores)",
      "datasource": "$${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pve_cpu_usage_ratio * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"} * on(id) pve_cpu_usage_limit)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 4
    },
    {
      "type": "stat",
      "title": "RAM allocated",
      "datasource": "$${DS_PROMETHEUS}",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(pve_memory_size_bytes * on(id) group_left(name, node) pve_guest_info{template=\"0\",tags=~\"(.*;)?$${tag}(;.*)?\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "id": 5
    },
